{
  "appId": "ch.marccawood.easydbaccess",
  "productName": "easyDBAccess",
  "electronVersion": "33.4.11",
  "directories": {
    "output": "dist-installer"
  },
  "files": [
    "dist/**/*",
    "../renderer/dist/**/*",
    "../server/dist/**/*"
  ],
  "win": {
    "target": "nsis"
  },
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage"
  },
  "publish": {
    "provider": "github"
  }
}