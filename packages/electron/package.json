{
  "name": "@easydb/electron",
  "version": "0.0.7",
  "private": true,
  "description": "easyDBAccess desktop shell — Electron wrapper around the renderer.",
  "author": "Marc Cawood",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc -b --force",
    "start": "electron .",
    "package": "electron-builder --config electron-builder.json"
  },
  "dependencies": {
    "@easydb/shared": "file:../shared",
    "@easydb/server": "file:../server"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}