# easyDBAccess server configuration
#
# Copy to `.env` (also in packages/server/) and edit. The file is gitignored.
# Loaded automatically by src/standalone.ts on startup via Node's built-in
# process.loadEnvFile — no dotenv dependency.
#
# Explicit env vars on the command line override values from this file.

# -- HTTP ---------------------------------------------------------------------

PORT=3000

# -- Storage ------------------------------------------------------------------

# Which adapter to use. One of:
#   fs      filesystem — one ${STORAGE_PATH}/<workspaceId>.db.json per workspace
#   sqlite  SQLite     — one ${STORAGE_PATH}/<workspaceId>.db per workspace, each holding real SQL tables
STORAGE_KIND=fs

# Directory holding per-workspace files (created if missing):
#   fs:     ${id}.db.json files
#   sqlite: ${id}.db files
STORAGE_PATH=./.easydb-store

# -- CORS ---------------------------------------------------------------------

# Comma-separated list of allowed origins for the browser, or "*" for any.
# Empty disables CORS entirely (Electron / same-origin deployments).
CORS_ORIGINS=*

# -- /fetch URL proxy ---------------------------------------------------------

# Comma-separated host allowlist for the /fetch proxy. Empty/unset = allow all.
# FETCH_ALLOWLIST=api.github.com,example.com

# Maximum bytes the proxy will return. Defaults to 5 MB.
# FETCH_MAX_BYTES=5000000

# -- /plugins/registry --------------------------------------------------------

# Path to a JSON file (shape: { "plugins": [{ id, name, description?, url }] })
# served by GET /plugins/registry. The renderer's Plugin Manager dialog renders
# the contents in a "From server" section. Unset = empty list.
# PLUGINS_REGISTRY_PATH=./plugins-registry.json
