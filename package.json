{
  "name": "easydbaccess",
  "author": "Marc Cawood",
  "license": "MIT",
  "version": "0.0.394",
  "private": true,
  "repository": "https://github.com/cawoodm/easydbaccess",
  "description": "Local-first, plugin-extensible, multi-table database app — runs in the browser and as an Electron desktop app.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @easydb/renderer & npm run dev --workspace @easydb/server",
    "dev:renderer": "npm run dev --workspace @easydb/renderer",
    "dev:server": "npm run dev --workspace @easydb/server",
    "dev:electron": "npm run dev --workspace @easydb/electron",
    "start:electron": "npm run start --workspace @easydb/electron",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:desktop": "playwright test --config playwright.electron.config.ts",
    "typecheck": "tsc -b && tsc -p test/tsconfig.json",
    "lint": "eslint packages test",
    "format": "prettier --write \"{packages,test}/**/*.{ts,js,json,html,md}\"",
    "publish": "pwsh -File ./publish.ps1",
    "build:electron": "pwsh -File ./package-electron.ps1",
    "package:electron": "pwsh -File ./package-electron.ps1 -Installer",
    "docker": "pwsh -File ./docker.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=24"
  }
}
